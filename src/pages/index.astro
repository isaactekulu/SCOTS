---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-[--focus] focus:text-white focus:px-5 focus:py-3 focus:rounded-lg focus:text-lg focus:font-semibold no-underline focus:min-h-0 focus:min-w-0">
    Skip to main content
  </a>

  <div id="a11y-announce" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <header class="sticky top-0 z-50 bg-gradient-to-r from-[--navy] to-[--navy-mid] border-b border-white/10" x-data="accessibilityTools()" role="banner">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 flex items-center justify-between h-14 sm:h-16">
      <span class="text-white font-bold text-lg sm:text-xl tracking-tight">SCOTS</span>

      <div class="flex items-center gap-1.5 sm:gap-2" role="toolbar" aria-label="Accessibility tools">
        <button
          @click="toggleReadAloud()"
          :class="reading ? 'bg-red-500' : 'bg-white/10 hover:bg-white/20'"
          class="px-2.5 sm:px-3 rounded-lg text-xs sm:text-sm font-medium text-white whitespace-nowrap min-h-[44px] flex items-center"
          aria-label="Read this page aloud"
          :aria-label="reading ? 'Stop reading' : 'Read this page aloud'"
          :aria-pressed="reading.toString()"
          x-text="reading ? 'Stop' : 'Read aloud'"
        >Read aloud</button>

        <span class="w-px h-6 bg-white/20 mx-0.5 sm:mx-1" aria-hidden="true"></span>

        <button
          @click="cycleSize()"
          class="flex flex-col items-center justify-center w-11 h-11 rounded-lg bg-white/10 hover:bg-white/20 text-white"
          aria-label="Change text size"
          :aria-label="'Change text size, currently ' + textSize"
        >
          <span class="font-bold text-sm leading-none" x-text="textSize === 'normal' ? 'A' : textSize === 'large' ? 'A+' : 'A++'">A</span>
          <span class="text-[9px] text-white/60 leading-none mt-0.5">Size</span>
        </button>

        <button
          @click="toggleContrast()"
          :class="highContrast ? 'bg-yellow-400 text-black' : 'bg-white/10 hover:bg-white/20 text-white'"
          class="flex flex-col items-center justify-center w-11 h-11 rounded-lg"
          aria-label="Toggle high contrast"
          :aria-pressed="highContrast.toString()"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-width="2" d="M12 3v18a9 9 0 000-18z" fill="currentColor"/></svg>
          <span class="text-[9px] opacity-60 leading-none mt-0.5" x-text="highContrast ? 'On' : 'Contrast'">Contrast</span>
        </button>

        <button
          @click="toggleColorBlind()"
          :class="colorBlind ? 'bg-orange-500 text-white' : 'bg-white/10 hover:bg-white/20 text-white'"
          class="flex flex-col items-center justify-center w-11 h-11 rounded-lg"
          aria-label="Toggle color blind mode"
          :aria-pressed="colorBlind.toString()"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          <span class="text-[9px] opacity-60 leading-none mt-0.5" x-text="colorBlind ? 'On' : 'Vision'">Vision</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-white" aria-labelledby="page-title">
      <div class="max-w-[900px] mx-auto px-6 py-12 md:py-16">
        <h1 id="page-title" class="text-[--navy] mb-4">What to Expect From Your Appointment</h1>
        <p class="text-[--text-muted] text-lg max-w-[640px] leading-relaxed">
          Southern Community Orthopedic Triage Service (SCOTS). This page explains why you have been referred, what happens during your appointment, and how to prepare.
        </p>
      </div>
    </section>

    <div class="max-w-[900px] mx-auto px-6">

      <!-- Why have I been referred? -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="referral-heading">
        <h2 id="referral-heading" class="text-[--navy] mb-5">Why have I been referred?</h2>
        <p class="text-[--text-muted]">
          You have been referred to SCOTS Orthopaedic Outpatient Services to assess your musculoskeletal condition (e.g. concerns with your joints, muscles, other soft tissues) and determine the best pathway for you.
        </p>
        <p class="font-medium mb-3">This may include:</p>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2">
          <li>Advice and education</li>
          <li>A structured rehabilitation plan</li>
          <li>An education program</li>
          <li>Referral to further services (if needed)</li>
        </ul>
      </section>

      <!-- What will happen at my appointment? -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="appointment-heading">
        <h2 id="appointment-heading" class="text-[--navy] mb-5">What will happen at my appointment?</h2>
        <p class="text-[--text-muted] mb-5">We will:</p>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2 mb-5">
          <li>Listen to your concerns and goals</li>
          <li>Assess your condition</li>
          <li>Review any previous treatment</li>
          <li>Discuss your diagnosis and options</li>
        </ul>
        <div class="bg-gradient-to-r from-[--navy] to-[--navy-light] rounded-xl p-6">
          <p class="text-white font-bold mb-0">Together, we will agree on a clear plan forward.</p>
        </div>
      </section>

      <!-- What if I have already trialed physiotherapy? -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="physio-heading">
        <h2 id="physio-heading" class="text-[--navy] mb-5">What if I have already trialed physiotherapy?</h2>
        <p class="text-[--text-muted]">That is helpful information. We will look at:</p>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2 mb-5">
          <li>What type of treatment you have had</li>
          <li>How long you tried it for</li>
          <li>Whether it was targeted and progressive</li>
          <li>Whether it was specifically tailored to your problem</li>
        </ul>
        <div class="bg-gradient-to-r from-[--navy] to-[--navy-light] rounded-xl p-6">
          <p class="text-white font-bold mb-0">Sometimes a more structured approach can still lead to improvement.</p>
        </div>
      </section>

      <!-- What happens after the assessment? -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="outcomes-heading">
        <h2 id="outcomes-heading" class="text-[--navy] mb-5">What happens after the assessment?</h2>
        <p class="text-[--text-muted] mb-5">Depending on your assessment, we may:</p>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2 mb-5">
          <li>Start or adjust a rehabilitation plan</li>
          <li>Invite you to an education program</li>
          <li>Discharge you with advice</li>
          <li>Refer you for further investigations</li>
          <li>Refer you for a surgical opinion</li>
        </ul>
        <p class="text-[--text-muted]">If a trial of treatment is recommended, we will set a clear timeframe and review your progress.</p>
      </section>

      <!-- Our Objectives -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="objectives-heading">
        <h2 id="objectives-heading" class="text-[--navy] mb-5">Our Objectives</h2>
        <ol class="list-none space-y-4 pl-0" role="list">
          <li class="flex gap-4 items-start bg-white border-2 border-[--border] rounded-xl px-5 py-4">
            <span class="w-10 h-10 rounded-full bg-[--teal] text-white flex items-center justify-center font-bold text-lg flex-shrink-0">1</span>
            <span>To make sure you receive the right treatment, at the right time, for the best possible outcome.</span>
          </li>
          <li class="flex gap-4 items-start bg-white border-2 border-[--border] rounded-xl px-5 py-4">
            <span class="w-10 h-10 rounded-full bg-[--teal] text-white flex items-center justify-center font-bold text-lg flex-shrink-0">2</span>
            <span>Ensure you have access to a comprehensive trial of rehabilitation and education programs to consider their effectiveness.</span>
          </li>
          <li class="flex gap-4 items-start bg-white border-2 border-[--border] rounded-xl px-5 py-4">
            <span class="w-10 h-10 rounded-full bg-[--teal] text-white flex items-center justify-center font-bold text-lg flex-shrink-0">3</span>
            <span>Support you by providing strategies you can use to manage your condition by yourself where appropriate.</span>
          </li>
        </ol>
      </section>

      <!-- How to prepare -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="prepare-heading">
        <h2 id="prepare-heading" class="text-[--navy] mb-5">How you can prepare for the assessment</h2>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2 mb-5">
          <li>Bring any relevant scan reports or letters</li>
          <li>Wear comfortable clothing for assessment</li>
          <li>Be ready to discuss how your condition affects your daily life</li>
        </ul>
        <p class="text-[--text-muted]">If you have any questions before seeing us, please speak with your GP or the referring clinician.</p>
        <div class="bg-gradient-to-r from-[--navy] to-[--navy-light] rounded-xl p-6 mt-5">
          <p class="text-white font-bold mb-0">We look forward to supporting you. — SCOTS Team.</p>
        </div>
      </section>

      <!-- About Us -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="about-heading">
        <h2 id="about-heading" class="text-[--navy] mb-5">About Us</h2>
        <p class="text-[--text-muted]">
          SCOTS is part of the Orthopaedic Outpatient Department Services and is designed to help patients with musculoskeletal conditions access the right care, at the right time, in the right place. We provide assessment and guidance for people experiencing these problems, ensuring that treatment pathways are clear, appropriate, and effective.
        </p>
        <h3 class="text-[--navy] mt-6 mb-3">Our Role</h3>
        <p class="text-[--text-muted]">
          SCOTS provides assessment to determine the most appropriate pathway for you. We work closely with GPs, community providers, and Orthopaedic teams to determine whether a patient is best managed with:
        </p>
        <ul class="list-disc pl-7 text-[--text-muted] space-y-2 mb-5">
          <li>Targeted non-surgical treatment</li>
          <li>Further investigation</li>
          <li>Or referral for orthopaedic (surgical) opinion</li>
        </ul>
        <h3 class="text-[--navy] mt-6 mb-3">Why SCOTS Exists</h3>
        <p class="text-[--text-muted]">
          Clinical practice guidelines indicate that the gold standard of management for many musculoskeletal/orthopedic conditions (including Osteoarthritis) is a comprehensive targeted, and time appropriate trial of non-surgical strategies. SCOTS ensures you have access to these strategies and can trial them appropriately for your condition.
        </p>
      </section>

      <!-- Locations -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="locations-heading">
        <h2 id="locations-heading" class="text-[--navy] mb-6">Our Service Locations</h2>
        <div class="space-y-5">
          <div class="bg-white border border-[--border] rounded-xl p-6">
            <p class="font-bold text-[--navy] mb-2">Assessment Clinics</p>
            <p class="mb-1">Te Kaika Wellbeing Hub</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Te+Kaika+Wellbeing+Hub+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Get directions<span class="sr-only"> (opens in new tab)</span>
            </a>
            <p class="mb-1">Zingari Richmond Football Club</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Zingari+Richmond+Football+Club+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Get directions<span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
          <div class="bg-white border border-[--border] rounded-xl p-6">
            <p class="font-bold text-[--navy] mb-2">Rehab Program Sites</p>
            <p class="mb-1">Zingari Richmond Football Club Gym</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Zingari+Richmond+Football+Club+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Get directions<span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
          <div class="bg-white border border-[--border] rounded-xl p-6">
            <p class="font-bold text-[--navy] mb-2">Education Program Sites</p>
            <p class="mb-1">Nutrition Clinic — Otago University</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=University+of+Otago+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Get directions<span class="sr-only"> (opens in new tab)</span>
            </a>
            <p class="mb-1">Chatsford Retirement Village Events Centre</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Chatsford+Retirement+Village+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Get directions<span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Contact & Resources -->
      <section class="py-12 scroll-mt-40 fade-up" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="text-[--navy] mb-5">Contact Us</h2>
        <p class="text-[--text-muted] mb-8">Contact details will be made available after your appointment with us.</p>

        <h3 class="text-[--navy] mb-4">Helpful Resources and Links</h3>
        <p class="text-[--text-muted]">
          Arthritis New Zealand: <a href="https://www.arthritis.org.nz/" target="_blank" rel="noopener noreferrer">www.arthritis.org.nz<span class="sr-only"> (opens in new tab)</span></a>
        </p>
      </section>
    </div>
  </main>
</Layout>
