---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-[--focus] focus:text-white focus:px-5 focus:py-3 focus:rounded-lg focus:text-lg focus:font-semibold no-underline focus:min-h-0 focus:min-w-0">
    Skip to main content
  </a>

  <div id="a11y-announce" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <header class="sticky top-0 z-50 bg-gradient-to-r from-[--navy] to-[--navy-mid] border-b border-white/10" x-data="accessibilityTools()" role="banner">
    <div class="max-w-[900px] md:max-w-none mx-auto px-4 sm:px-6 md:px-12 lg:px-20">
      <div class="flex items-center justify-between min-h-[3.5rem] sm:h-16 py-2 sm:py-0 gap-3">
        <span class="text-white font-bold text-[0.9rem] sm:text-base md:text-xl tracking-tight leading-tight min-w-0 break-words text-center md:text-left">
          Southern Community Orthopaedic Triage Service <span class="text-[#5ce1e6]">(SCOTS)</span>
        </span>

        <!-- Desktop: always visible -->
        <div class="hidden md:flex items-center gap-2 shrink-0" role="toolbar" aria-label="Accessibility tools">
          <button
            @click="toggleReadAloud()"
            :class="reading ? 'bg-red-500' : 'bg-white/10 hover:bg-white/20'"
            class="px-3 rounded-lg text-sm font-medium text-white whitespace-nowrap min-h-[44px] flex items-center shrink-0"
            aria-label="Read this page aloud"
            :aria-label="reading ? 'Stop reading' : 'Read this page aloud'"
            :aria-pressed="reading.toString()"
            x-text="reading ? 'Stop' : 'Read aloud'"
          >Read aloud</button>

          <span class="w-px h-6 bg-white/20 mx-1" aria-hidden="true"></span>

          <button
            @click="cycleSize()"
            class="flex flex-col items-center justify-center w-11 h-11 rounded-lg bg-white/10 hover:bg-white/20 text-white"
            aria-label="Change text size"
            :aria-label="'Change text size, currently ' + textSize"
          >
            <span class="font-bold text-sm leading-none" x-text="textSize === 'normal' ? 'A' : textSize === 'large' ? 'A+' : 'A++'">A</span>
            <span class="text-[9px] text-white/60 leading-none mt-0.5">Size</span>
          </button>

          <button
            @click="toggleContrast()"
            :class="highContrast ? 'bg-yellow-400 text-black' : 'bg-white/10 hover:bg-white/20 text-white'"
            class="flex flex-col items-center justify-center w-11 h-11 rounded-lg"
            aria-label="Toggle high contrast"
            :aria-pressed="highContrast.toString()"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-width="2" d="M12 3v18a9 9 0 000-18z" fill="currentColor"/></svg>
            <span class="text-[9px] opacity-60 leading-none mt-0.5" x-text="highContrast ? 'On' : 'Contrast'">Contrast</span>
          </button>

          <button
            @click="toggleColorBlind()"
            :class="colorBlind ? 'bg-orange-500 text-white' : 'bg-white/10 hover:bg-white/20 text-white'"
            class="flex flex-col items-center justify-center w-11 h-11 rounded-lg"
            aria-label="Toggle color blind mode"
            :aria-pressed="colorBlind.toString()"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span class="text-[9px] opacity-60 leading-none mt-0.5" x-text="colorBlind ? 'On' : 'Vision'">Vision</span>
          </button>
        </div>
      </div>

        <!-- Mobile/tablet: always visible accessibility bar below title -->
        <div class="md:hidden border-t border-white/10 py-3 -mx-4 px-4 bg-[#0a3550]">
          <div class="grid grid-cols-4 gap-2" role="toolbar" aria-label="Accessibility tools">
          <button
            @click="toggleReadAloud()"
            :class="reading ? 'bg-red-500' : 'bg-white/10 hover:bg-white/20'"
            class="flex flex-col items-center justify-center rounded-lg text-xs font-medium text-white min-h-[56px] px-1 col-span-1"
            :aria-pressed="reading.toString()"
          >
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12M8.464 8.464a5 5 0 000 7.072"/></svg>
            <span x-text="reading ? 'Stop' : 'Read'">Read</span>
          </button>

          <button
            @click="cycleSize()"
            class="flex flex-col items-center justify-center rounded-lg bg-white/10 hover:bg-white/20 text-white min-h-[56px] col-span-1"
            aria-label="Change text size"
          >
            <span class="font-bold text-lg leading-none mb-1" x-text="textSize === 'normal' ? 'A' : textSize === 'large' ? 'A+' : 'A++'">A</span>
            <span class="text-[10px] opacity-70">Size</span>
          </button>

          <button
            @click="toggleContrast()"
            :class="highContrast ? 'bg-yellow-400 text-black' : 'bg-white/10 hover:bg-white/20 text-white'"
            class="flex flex-col items-center justify-center rounded-lg min-h-[56px] col-span-1"
            aria-label="Toggle high contrast"
            :aria-pressed="highContrast.toString()"
          >
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-width="2" d="M12 3v18a9 9 0 000-18z" fill="currentColor"/></svg>
            <span class="text-[10px] opacity-70">Contrast</span>
          </button>

          <button
            @click="toggleColorBlind()"
            :class="colorBlind ? 'bg-orange-500 text-white' : 'bg-white/10 hover:bg-white/20 text-white'"
            class="flex flex-col items-center justify-center rounded-lg min-h-[56px] col-span-1"
            aria-label="Toggle color blind mode"
            :aria-pressed="colorBlind.toString()"
          >
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span class="text-[10px] opacity-70">Vision</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">

    <div class="max-w-[900px] md:max-w-none mx-auto px-6 md:px-12 lg:px-20">

      <!-- Page title -->
      <section class="pt-10 pb-6 fade-up text-center md:text-left">
        <h1 class="text-[--navy]">Step Out With Confidence!</h1>
      </section>

      <!-- Who we are -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="who-heading">
        <h2 id="who-heading">Who we are</h2>
        <p>SCOTS as a service is part of the Orthopaedic Outpatient Department Services and is designed to help patients with musculoskeletal conditions (e.g concerns with your joints, muscles, other soft tissues) access the right care, at the right time, in the right place. We provide assessment and guidance for people experiencing these problems, ensuring that treatment pathways are clear, appropriate, and effective.</p>
      </section>

      <!-- Why SCOTS exists -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="why-heading">
        <h2 id="why-heading">Why SCOTS exists</h2>
        <p>Clinical practice guidelines indicate that the gold standard of management for many musculoskeletal/orthopaedic conditions (including Osteoarthritis) is a comprehensive targeted, and time appropriate trial of non surgical strategies. SCOTS ensures you have access to these strategies and can trial them appropriately for your condition.</p>
      </section>

      <!-- Our role -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="role-heading">
        <h2 id="role-heading">Our role</h2>
        <p>SCOTS provides assessment to determine the most appropriate pathway for you.</p>
        <p>We work closely with GPs, community providers, and Orthopaedic teams to support this.</p>
      </section>

      <!-- Our objectives -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="objectives-heading">
        <h2 id="objectives-heading">Our objectives</h2>
        <ul class="list-disc pl-7 space-y-2">
          <li>To make sure you receive the right treatment, at the right time, for the best possible outcome.</li>
          <li>Ensure you have access to a comprehensive trial of rehabilitation and education programs to consider their effectiveness.</li>
          <li>Support you to step out in confidence by providing strategies you can use to manage your condition by yourself where appropriate.</li>
        </ul>
      </section>

      <!-- What will happen at my appointment? -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="appointment-heading">
        <h2 id="appointment-heading">What will happen at my appointment?</h2>
        <p>We will:</p>
        <ul class="list-disc pl-7 space-y-2 mb-4">
          <li>Listen to your concerns and goals</li>
          <li>Assess your condition</li>
          <li>Review any previous treatment</li>
          <li>Discuss your diagnosis and options</li>
        </ul>
        <p>Together, we will agree on a clear plan forward.</p>
      </section>

      <!-- What if I have already trialed Physiotherapy? -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="physio-heading">
        <h2 id="physio-heading">What if I have already trialed Physiotherapy?</h2>
        <p>That is helpful information.</p>
        <p>We will look at:</p>
        <ul class="list-disc pl-7 space-y-2 mb-4">
          <li>What type of treatment you have had</li>
          <li>How long you tried it for</li>
          <li>Whether it was targeted and progressive</li>
          <li>Whether it was specifically tailored to your problem</li>
        </ul>
        <p>Sometimes a more structured approach can still lead to improvement.</p>
      </section>

      <!-- How can I prepare for the assessment? -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="prepare-heading">
        <h2 id="prepare-heading">How can I prepare for the assessment?</h2>
        <ul class="list-disc pl-7 space-y-2">
          <li>Bring any relevant scan reports or letters</li>
          <li>Wear comfortable clothing for assessment</li>
          <li>Be ready to discuss how your condition affects your daily life</li>
        </ul>
      </section>

      <!-- What happens after the assessment? -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="outcomes-heading">
        <h2 id="outcomes-heading">What happens after the assessment?</h2>
        <p>Depending on your assessment, we may:</p>
        <ul class="list-disc pl-7 space-y-2 mb-4">
          <li>Start or adjust a rehabilitation plan</li>
          <li>Invite you to an education program</li>
          <li>Discharge you with advice</li>
          <li>Refer you for further investigations</li>
          <li>Refer you for a surgical opinion</li>
        </ul>
        <p>If a trial of treatment is recommended, we will set a clear timeframe and review your progress.</p>
      </section>

      <!-- After I have completed the program what is next? -->
      <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="after-program-heading">
        <h2 id="after-program-heading">After I have completed the program what is next?</h2>
        <p>We will provide a review assessment after you have completed your treatment to consider your progress and agree on the best plan moving forward.</p>
      </section>

      <!-- Closing -->
      <section class="py-8 scroll-mt-40 fade-up">
        <p>If you have any questions before seeing us, please speak with your GP or the referring clinician.</p>
        <p>We look forward to supporting you. - SCOTS Team.</p>
      </section>

    </div>

    <!-- ============ SECONDARY CONTENT ============ -->
    <div class="bg-[#f5f7f9]">
      <div class="max-w-[900px] md:max-w-none mx-auto px-6 md:px-12 lg:px-20">

        <!-- Locations -->
        <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="locations-heading">
          <h2 id="locations-heading">Our Service Locations</h2>
          <div class="space-y-5">
            <div class="bg-white border border-[--border] rounded-xl p-6">
              <p class="font-bold text-[--navy] mb-2">Assessment Clinics</p>
              <p class="mb-1">Te Kaika Wellbeing Hub</p>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Te+Kaika+Wellbeing+Hub+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Get directions<span class="sr-only"> (opens in new tab)</span>
              </a>
              <p class="mb-1">Zingari Richmond Football Club</p>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Zingari+Richmond+Football+Club+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Get directions<span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
            <div class="bg-white border border-[--border] rounded-xl p-6">
              <p class="font-bold text-[--navy] mb-2">Rehab Program Sites</p>
              <p class="mb-1">Zingari Richmond Football Club Gym</p>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Zingari+Richmond+Football+Club+Dunedin" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Get directions<span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
            <div class="bg-white border border-[--border] rounded-xl p-6">
              <p class="font-bold text-[--navy] mb-2">Education Program Sites</p>
              <p class="mb-1">Nutrition Clinic — Otago University</p>
              <a href="https://maps.app.goo.gl/qo6CfVsT34FZ98Ec8" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Get directions<span class="sr-only"> (opens in new tab)</span>
              </a>
              <p class="mb-1">Chatsford Retirement Village Events Centre</p>
              <a href="https://maps.app.goo.gl/MMpk3WzWC6k67nqj6" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[--teal] text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Get directions<span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Contact -->
        <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="contact-heading">
          <h2 id="contact-heading">Contact Us</h2>
          <p>Contact details will be made available after your appointment with us.</p>
        </section>

        <!-- Helpful Links -->
        <section class="py-8 scroll-mt-40 fade-up" aria-labelledby="links-heading">
          <h2 id="links-heading">Helpful Links</h2>
          <ol class="list-decimal pl-7 space-y-2">
            <li>Arthritis New Zealand: <a href="https://www.arthritis.org.nz/" target="_blank" rel="noopener noreferrer">https://www.arthritis.org.nz/<span class="sr-only"> (opens in new tab)</span></a></li>
            <li>Otago University Pharmacy Clinic: <a href="https://www.otago.ac.nz/pharmacy-clinic" target="_blank" rel="noopener noreferrer">https://www.otago.ac.nz/pharmacy-clinic<span class="sr-only"> (opens in new tab)</span></a></li>
          </ol>
          <p class="mt-6">
            You can also view the <a href="/Pdf/SCOTS-Information-Sheet.pdf" target="_blank" rel="noopener noreferrer">PDF version of this information<span class="sr-only"> (opens in new tab)</span></a>.
          </p>
        </section>

      </div>
    </div>
  </main>
</Layout>
